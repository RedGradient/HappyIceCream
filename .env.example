DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# В Docker Compose: db / redis. Локально без Compose: localhost.
# POSTGRES_PORT — порт внутри сети Compose.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=happyicecream
POSTGRES_USER=happyicecream
POSTGRES_PASSWORD=happyicecream
# Порт на хосте (проброс). Меняем, если 5432 занят.
POSTGRES_PUBLISH_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

WEB_PORT=8000

# Email (Resend SMTP). Если RESEND_API_KEY пустой, письма пишутся в консоль.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Happy Ice Cream <noreply@happy-ice-cream.com>
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=587
RESEND_SMTP_USERNAME=resend
RESEND_SMTP_USE_TLS=1
