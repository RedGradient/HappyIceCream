DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# В Docker Compose: db / redis. Локально без Compose: localhost.
# POSTGRES_PORT — порт внутри сети Compose.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=happyicecream
POSTGRES_USER=happyicecream
POSTGRES_PASSWORD=happyicecream
# Порт на хосте (проброс). Меняем, если 5432 занят.
POSTGRES_PUBLISH_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

WEB_PORT=8000
